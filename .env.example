# Server
PORT=8080

# Optional OpenAI-compatible LLM configuration.
# The prototype runs with deterministic fallback narratives if these are unset.
OPENAI_API_KEY=your_openai_or_openai_compatible_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Nebius-compatible setup example.
# OPENAI_BASE_URL=https://api.studio.nebius.com/v1
# OPENAI_MODEL=your_valid_nebius_model_id_here

# Report assumptions
DEFAULT_WACC=0.095
DEFAULT_TERMINAL_GROWTH=0.025
DEFAULT_TAX_RATE=0.25
