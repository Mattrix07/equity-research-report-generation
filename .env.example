# Server
PORT=8080

# Data provider
# Use DATA_PROVIDER=fmp once you add your Financial Modeling Prep key locally.
# Do not commit real keys.
DATA_PROVIDER=fmp
FMP_API_KEY=your_financial_modeling_prep_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_STATEMENT_LIMIT=10
FMP_TIMEOUT_SECONDS=30
MIN_STATEMENT_YEARS=5

# Optional LLM configuration.
# Without this, the app still runs using deterministic Python calculations.
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional multi LLM investment committee.
ENABLE_LLM_COMMITTEE=false
LLM_TIMEOUT_SECONDS=90

# Optional separate model routing by agent.
LLM_MANAGER_MODEL=gpt-4o-mini
LLM_BULL_MODEL=gpt-4o-mini
LLM_BEAR_MODEL=gpt-4o-mini
LLM_VALUATION_MODEL=gpt-4o-mini
LLM_REPORT_WRITER_MODEL=gpt-4o-mini
LLM_QA_MODEL=gpt-4o-mini

# Optional native Excel recalculation.
# Requires Microsoft Excel installed locally and xlwings available.
# Keep false on servers/headless environments.
ENABLE_EXCEL_RUNTIME=false

# Fallback report assumptions
DEFAULT_WACC=0.095
DEFAULT_TERMINAL_GROWTH=0.025
DEFAULT_TAX_RATE=0.25
